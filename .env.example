# MacroSentinel 配置
# 复制此文件为 .env 并填入实际值

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 代理开关：true/false（服务器部署或直连网络时设为 false）
PROXY_ENABLED=true
PROXY_URL=http://127.0.0.1:58309

# Jina Reader API 开关（用于解析反爬页面，如 Finviz）
# 设为 false 则直接请求原始页面（需要目标站点不反爬）
JINA_ENABLED=true

# 轮询间隔（秒）
CHECK_INTERVAL=300

# 企业微信群机器人 Webhook 地址（留空则不推送）
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key-here
